<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <AssemblyName>AssetViewer.UnrealDecode</AssemblyName>
    <RootNamespace>AssetViewer.UnrealDecode</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../formats/dotnet/BlockCompression.cs" Link="Formats/BlockCompression.cs" />
    <Compile Include="../../../formats/dotnet/Bc7Texture.cs" Link="Formats/Bc7Texture.cs" />
    <None Include="../../../formats/dotnet/Notices/BCnEncoder-LICENSE.txt" Link="Notices/BCnEncoder-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="BCnEncoder.Net" Version="[2.3.0]" />
    <PackageReference Include="CUE4Parse" Version="[1.2.2.202611]" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="[10.0.9]" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="536870912" />
  </ItemGroup>
  <Import Project="Notices/PublishNotices.targets" />
</Project>
