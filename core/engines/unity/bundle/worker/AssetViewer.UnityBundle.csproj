<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../formats/dotnet/BlockCompression.cs" Link="Formats/BlockCompression.cs" />
    <PackageReference Include="AssetsTools.NET" Version="[3.0.5]" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="402653184" />
    <None Update="Notices/AssetsTools.NET.LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <DotNetRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Copy SourceFiles="%(DotNetRuntimePack.PackageDirectory)/LICENSE.TXT;%(DotNetRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT"
          DestinationFolder="$(PublishDir)/Notices" SkipUnchangedFiles="true" />
  </Target>
</Project>
